<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WordRelay.Mobile</RootNamespace>
    <ApplicationId>local.wordrelay.android</ApplicationId>
    <ApplicationTitle>Word Relay</ApplicationTitle>
    <ApplicationVersion>10400</ApplicationVersion>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../windows/Core/*.cs" LinkBase="Core" />
    <AndroidAsset Include="../Resources/words.txt" Link="Assets/words.txt" />
    <AndroidAsset Include="../Resources/words-extra.txt" Link="Assets/words-extra.txt" />
    <AndroidAsset Include="../windows/Assets/glyphs.bin" Link="Assets/glyphs.bin" />
    <AndroidAsset Include="../Resources/ESDB-Copyright.txt" Link="Assets/ESDB-Copyright.txt" />
    <AndroidAsset Include="../Resources/Fredoka-OFL.txt" Link="Assets/Fredoka-OFL.txt" />
  </ItemGroup>
</Project>
